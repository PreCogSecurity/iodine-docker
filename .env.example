# iodine-docker configuration
# Copy this file to .env and adjust the values before running:
#   docker compose up -d

# The domain where your iodine server is running (required).
# Must be a fully qualified DNS name with at least two dot-separated labels,
# e.g. t.example.com. Uppercase is accepted and lowercased on startup.
IODINE_HOST=t.example.com

# The password for your iodine server (required unless IODINE_PASSWORD_FILE is
# set). Must not start with '-' and must not contain control characters.
# Use at least 8 characters: this value is the only thing protecting the
# tunnel, and it is brute-forceable offline from captured DNS traffic.
IODINE_PASSWORD=change-me-to-something-long

# Alternative to IODINE_PASSWORD: a file containing the password. Preferred,
# because it keeps the secret out of `docker inspect` output. Takes precedence
# over IODINE_PASSWORD when both are set. Commented out because it does not map
# onto a plain `docker run -e`; see the README for the Compose example.
# IODINE_PASSWORD_FILE=/run/secrets/iodine_password

# The server tunnel IP (optional, defaults to 10.0.0.1).
# Dotted-quad IPv4 only, four octets 0-255, no leading zeros.
IODINE_TUNNEL_IP=10.0.0.1

# Optional: rotate /var/log/iodined.log once it grows past this many bytes
# (default 10485760 = 10 MiB), keeping one previous generation.
# IODINE_LOG_MAX_BYTES=10485760